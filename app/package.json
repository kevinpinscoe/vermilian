{
  "name": "vermilian",
  "productName": "Vermilian",
  "version": "1.8.0",
  "description": "monday.com-style Electron desktop client for self-hosted JetBrains YouTrack",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash e2e/package-e2e-build.sh && playwright test",
    "test:e2e:fresh": "bash e2e/package-e2e-build.sh && playwright test",
    "test:release-isolation": "bash e2e/package-e2e-build.sh --release && VERMILIAN_RELEASE_ISOLATION_CHECK=1 playwright test e2e/release-recorder-isolation.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:live:package": "bash e2e-live/package-dev-build.sh"
  },
  "keywords": [],
  "author": {
    "name": "kevinpinscoe",
    "url": "https://github.com/kevinpinscoe"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@reforged/maker-appimage": "^6.0.0",
    "@tanstack/react-query-devtools": "^5.108.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.4.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "tinyglobby": "^0.2.17",
    "typescript": "~6.0.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.108.3",
    "@vibe/core": "^4.5.39",
    "@vibe/icons": "^4.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "^5.1.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
